{
  "servers": {
    "github": {
      "type": "sse",
      "url": "https://api.githubcopilot.com/mcp/"
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@latest"]
    },
    "sequentialthinking": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"]
    },
    "chrome-devtools": {
      "command": "npx",
      "args": ["chrome-devtools-mcp@latest"]
    },
    "serena-mcp": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server",
        "--project",
        "/Users/nickcampbell/Projects/rust/shadowforge-rs"
      ]
    },
    "grep": {
      "type": "stdio",
      "command": "/Users/nickcampbell/.nodenv/versions/22.13.1/bin/grep-mcp",
      "args": ["--transport", "stdio"]
    },
    "coraline": {
      "command": "coraline",
      "args": ["serve", "--mcp"]
    },
    "stygian": {
      "type": "stdio",
      "command": "/Users/nickcampbell/.cargo/bin/stygian-mcp"
    }
  }
}
