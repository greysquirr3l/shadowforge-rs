      {
        "name": "Rust Keywords",
        "scope": [
          "keyword.control.rust",
          "keyword.other.rust",
          "storage.type.rust",
          "storage.modifier.rust"
        ],
        "settings": {
          "foreground": "#6b9e78",
          "fontStyle": "bold"
        }
      },
      {
        "name": "Rust Types",
        "scope": [
          "entity.name.type.rust",
          "support.type.primitive.rust",
          "entity.name.type.primitive.rust"
        ],
        "settings": {
          "foreground": "#78a8a8",
          "fontStyle": "italic"
        }
      },
      {
        "name": "Rust Functions and Macros",
        "scope": [
          "entity.name.function.rust",
          "support.function.rust",
          "entity.name.function.macro.rust"
        ],
        "settings": {
          "foreground": "#c9bd93",
          "fontStyle": "bold"
        }
      },
      {
        "name": "Rust Strings",
        "scope": ["string.quoted.double.rust", "string.quoted.single.rust"],
        "settings": {
          "foreground": "#d9c5a8"
        }
      },
      {
        "name": "Rust Numbers",
        "scope": ["constant.numeric.rust"],
        "settings": {
          "foreground": "#a8c5a8"
        }
      },
      {
        "name": "Rust Comments",
        "scope": ["comment.line.double-slash.rust", "comment.block.rust"],
        "settings": {
          "foreground": "#5a7e5a",
          "fontStyle": "italic"
        }
      },
      {
        "name": "Rust Module Names",
        "scope": ["entity.name.namespace.rust"],
        "settings": {
          "foreground": "#78a8a8",
          "fontStyle": "bold"
        }
      },
      {
        "name": "Rust Constants",
        "scope": ["constant.other.rust", "variable.other.constant.rust"],
        "settings": {
          "foreground": "#78a8a8",
          "fontStyle": "bold"
        }
      },
      {
        "name": "Rust Operators",
        "scope": ["keyword.operator.rust"],
        "settings": {
          "foreground": "#b8b5a1"
        }
      },
      {
        "name": "Rust Struct Fields",
        "scope": ["variable.other.member.rust"],
        "settings": {
          "foreground": "#c5bca8"
        }
      },
      {
        "name": "Rust Lifetime",
        "scope": [
          "storage.modifier.lifetime.rust",
          "entity.name.type.lifetime.rust"
        ],
        "settings": {
          "foreground": "#78a8a8",
          "fontStyle": "italic"
        }
      },
      {
        "name": "Rust Attributes",
        "scope": ["meta.attribute.rust"],
        "settings": {
          "foreground": "#6b9e78"
        }
      }
    ]
  },

  "editor.semanticTokenColorCustomizations": {
    "rules": {
      "*.deprecated": {
        "foreground": "#5a5e52",
        "fontStyle": "strikethrough"
      },
      "function.declaration": {
        "foreground": "#c9bd93",
        "fontStyle": "bold"
      },
      "method.declaration": {
        "foreground": "#c9bd93",
        "fontStyle": "bold"
      },
      "type": {
        "foreground": "#78a8a8",
        "fontStyle": "italic"
      },
      "struct": {
        "foreground": "#78a8a8",
        "fontStyle": "bold"
      },
      "interface": {
        "foreground": "#8ba888",
        "fontStyle": "italic bold"
      },
      "enum": {
        "foreground": "#78a8a8",
        "fontStyle": "bold"
      },
      "enumMember": {
        "foreground": "#9db89d",
        "fontStyle": "bold"
      },
      "variable.readonly": {
        "foreground": "#78a8a8",
        "fontStyle": "bold"
      },
      "parameter": {
        "foreground": "#c5bca8"
      },
      "property": {
        "foreground": "#c5bca8"
      },
      "lifetime": {
        "foreground": "#78a8a8",
        "fontStyle": "italic"
      },
      "macro": {
        "foreground": "#c9bd93",
        "fontStyle": "bold"
      }
    }
  },
  "sarif-viewer.connectToGithubCodeScanning": "on",

  // Python Configuration (for workflow scripts)
  "python-envs.defaultEnvManager": "ms-python.python:system",
  "python-envs.pythonProjects": [],
  "[python]": {
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    },
    "editor.defaultFormatter": "ms-python.black-formatter",
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.rulers": [88, 120]
  },
  "python.analysis.typeCheckingMode": "basic",
  "python.analysis.autoImportCompletions": true
}
