{
  // Rust/Cargo Configuration - 2026 Edition
  "rust-analyzer.cargo.buildScripts.enable": true,
  "rust-analyzer.cargo.features": "all",
  "rust-analyzer.cargo.loadOutDirsFromCheck": true,
  "rust-analyzer.cargo.runBuildScripts": true,
  "rust-analyzer.cargo.sysroot": "discover",
  "rust-analyzer.cargo.targetDir": true,
  "rust-analyzer.cargo.autoreload": true,

  // SQLx Offline Mode - Use pre-compiled query metadata from .sqlx/ directory
  "rust-analyzer.cargo.extraEnv": {
    "SQLX_OFFLINE": "true"
  },

  // Exclude reference projects from rust-analyzer
  "rust-analyzer.files.excludeDirs": ["reference_projects"],

  "rust-analyzer.checkOnSave.enable": true,
  "rust-analyzer.checkOnSave.command": "clippy",
  "rust-analyzer.checkOnSave.allTargets": true,
  "rust-analyzer.checkOnSave.allFeatures": true,
  "rust-analyzer.checkOnSave.extraEnv": {
    "SQLX_OFFLINE": "true"
  },
  "rust-analyzer.checkOnSave.extraArgs": [
    "--",
    "-W",
    "clippy::all",
    "-W",
    "clippy::pedantic",
    "-W",
    "clippy::nursery",
    "-W",
    "clippy::cargo",
    "-W",
    "clippy::perf",
    // Allow some pedantic lints that are too noisy
    "-A",
    "clippy::module_name_repetitions",
    "-A",
    "clippy::must_use_candidate",
    "-A",
    "clippy::missing_errors_doc",
    "-A",
    "clippy::missing_panics_doc",
    "-A",
    "clippy::struct_excessive_bools",
    // Security-focused lints (deny level)
    "-D",
    "clippy::unwrap_used",
    "-D",
    "clippy::expect_used",
    "-D",
    "clippy::panic",
    "-D",
    "clippy::indexing_slicing",
    "-D",
    "clippy::cast_ptr_alignment",
    "-D",
    "clippy::suspicious",
    "-D",
    "warnings"
  ],
  "rust-analyzer.checkOnSave.features": "all",
  "rust-analyzer.checkOnSave.noDefaultFeatures": false,
  "rust-analyzer.checkOnSave.targets": null,
  "rust-analyzer.diagnostics.enable": true,
  "rust-analyzer.diagnostics.experimental.enable": true,
  "rust-analyzer.diagnostics.disabled": [],
  "rust-analyzer.diagnostics.warningsAsHint": [],
  "rust-analyzer.diagnostics.warningsAsInfo": [],
  "rust-analyzer.diagnostics.styleLints.enable": true,
  "rust-analyzer.imports.granularity.enforce": true,
  "rust-analyzer.imports.granularity.group": "crate",
  "rust-analyzer.imports.prefix": "crate",
  "rust-analyzer.imports.merge.glob": true,
  "rust-analyzer.completion.autoimport.enable": true,
  "rust-analyzer.completion.autoself.enable": true,
  "rust-analyzer.completion.callable.snippets": "add_parentheses",
  "rust-analyzer.completion.postfix.enable": true,
  "rust-analyzer.completion.privateEditable.enable": true,
  "rust-analyzer.completion.fullFunctionSignatures.enable": true,
  "rust-analyzer.completion.termSearch.enable": true,
  "rust-analyzer.completion.snippets.custom": {
    "Arc::new": {
      "postfix": "arc",
      "body": "Arc::new(${receiver})",
      "requires": "std::sync::Arc",
      "description": "Wrap the expression in `Arc::new`",
      "scope": "expr"
    },
    "Rc::new": {
      "postfix": "rc",
      "body": "Rc::new(${receiver})",
      "requires": "std::rc::Rc",
      "description": "Wrap the expression in `Rc::new`",
      "scope": "expr"
    },
    "Box::new": {
      "postfix": "box",
      "body": "Box::new(${receiver})",
      "description": "Wrap the expression in `Box::new`",
      "scope": "expr"
    },
    "Ok": {
      "postfix": "ok",
      "body": "Ok(${receiver})",
      "description": "Wrap the expression in `Ok`",
      "scope": "expr"
    },
    "Err": {
      "postfix": "err",
      "body": "Err(${receiver})",
      "description": "Wrap the expression in `Err`",
      "scope": "expr"
    },
    "Some": {
      "postfix": "some",
      "body": "Some(${receiver})",
      "description": "Wrap the expression in `Some`",
      "scope": "expr"
    }
  },
  "rust-analyzer.hover.actions.enable": true,
  "rust-analyzer.hover.actions.implementations.enable": true,
  "rust-analyzer.hover.actions.references.enable": true,
  "rust-analyzer.hover.actions.run.enable": true,
  "rust-analyzer.hover.actions.debug.enable": true,
  "rust-analyzer.hover.documentation.enable": true,
  "rust-analyzer.hover.links.enable": true,
  "rust-analyzer.inlayHints.bindingModeHints.enable": true,
  "rust-analyzer.inlayHints.chainingHints.enable": true,
  "rust-analyzer.inlayHints.closingBraceHints.enable": true,
  "rust-analyzer.inlayHints.closingBraceHints.minLines": 10,
  "rust-analyzer.inlayHints.closureReturnTypeHints.enable": "with_block",
  "rust-analyzer.inlayHints.closureStyle": "rust_analyzer",
  "rust-analyzer.inlayHints.discriminantHints.enable": "fieldless",
  "rust-analyzer.inlayHints.expressionAdjustmentHints.enable": "reborrow",
  "rust-analyzer.inlayHints.expressionAdjustmentHints.mode": "postfix",
  "rust-analyzer.inlayHints.implicitDrops.enable": true,
  "rust-analyzer.inlayHints.lifetimeElisionHints.enable": "skip_trivial",
  "rust-analyzer.inlayHints.lifetimeElisionHints.useParameterNames": true,
  "rust-analyzer.inlayHints.maxLength": 25,
  "rust-analyzer.inlayHints.parameterHints.enable": true,
  "rust-analyzer.inlayHints.rangeExclusiveHints.enable": true,
  "rust-analyzer.inlayHints.reborrowHints.enable": "mutable",
  "rust-analyzer.inlayHints.renderColons": true,
  "rust-analyzer.inlayHints.typeHints.enable": true,
  "rust-analyzer.inlayHints.typeHints.hideClosureInitialization": false,
  "rust-analyzer.inlayHints.typeHints.hideNamedConstructor": false,
  "rust-analyzer.lens.enable": true,
  "rust-analyzer.lens.debug.enable": true,
  "rust-analyzer.lens.implementations.enable": true,
  "rust-analyzer.lens.references.adt.enable": true,
  "rust-analyzer.lens.references.enumVariant.enable": true,
  "rust-analyzer.lens.references.method.enable": true,
  "rust-analyzer.lens.references.trait.enable": true,
  "rust-analyzer.lens.run.enable": true,
  "rust-analyzer.lens.location": "above_name",
  "rust-analyzer.lens.forceCustomCommands": true,
  "rust-analyzer.notifications.cargoTomlNotFound": true,
  "rust-analyzer.procMacro.enable": true,
  "rust-analyzer.procMacro.attributes.enable": true,
  "rust-analyzer.procMacro.ignored": {},
  "rust-analyzer.runnables.command": null,
  "rust-analyzer.runnables.extraArgs": [],
  "rust-analyzer.runnables.extraEnv": null,
  "rust-analyzer.rustc.source": "discover",
  "rust-analyzer.rustfmt.extraArgs": [],
  "rust-analyzer.rustfmt.overrideCommand": null,
  "rust-analyzer.rustfmt.rangeFormatting.enable": false,
  "rust-analyzer.rustfmt.enableRangeFormatting": false,
  "rust-analyzer.semanticHighlighting.strings.enable": true,
  "rust-analyzer.semanticHighlighting.punctuation.enable": true,
  "rust-analyzer.semanticHighlighting.operator.enable": true,
  "rust-analyzer.semanticHighlighting.operator.specialization.enable": true,
  "rust-analyzer.workspace.symbol.search.scope": "workspace_and_dependencies",
  "rust-analyzer.workspace.symbol.search.kind": "all_symbols",
  "rust-analyzer.workspace.symbol.search.limit": 128,

  "[shellscript]": {
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll": "explicit"
    },
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.rulers": [80, 120],
    "files.trimTrailingWhitespace": true,
    "editor.suggest.showWords": true,
    "editor.wordBasedSuggestions": "currentDocument"
  },

  "[rust]": {
    "editor.formatOnSave": true,
    "editor.formatOnType": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit",
      "source.fixAll": "explicit"
    },
    "editor.snippetSuggestions": "top",
    "editor.defaultFormatter": "rust-lang.rust-analyzer",
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false,
    "editor.wordBasedSuggestions": "off",
    "editor.suggest.showWords": false,
    "editor.suggest.snippetsPreventQuickSuggestions": false,
    "editor.rulers": [80, 100, 120],
    "editor.semanticHighlighting.enabled": true,
    "editor.inlineSuggest.enabled": true,
    "editor.quickSuggestions": {
      "other": true,
      "comments": false,
      "strings": false
    },
    "editor.stickyScroll.enabled": true,
    "editor.bracketPairColorization.enabled": true,
    "editor.guides.bracketPairs": true
  },

  // GitHub Copilot Configuration - 2026 Latest Settings
  "github.copilot.enable": {
    "rust": true,
    "toml": true,
    "javascript": true,
    "typescript": true,
    "yaml": true,
    "dockerfile": true,
    "makefile": true,
    "json": true,
    "markdown": true,
    "shellscript": true,
    "*": true
  },
  "github.copilot.renameSuggestions.triggerAutomatically": true,
  "github.copilot.advanced": {
    "inlineSuggestCount": 3,
    "listCount": 10,
    "top_p": 1,
    "temperature": 0.1
  },
  "github.copilot.editor.enableAutoCompletions": true,
  "github.copilot.editor.enableCodeActions": true,
  "github.copilot.editor.iterativeFixing": true,

  // Copilot Chat - 2026 Enhanced Configuration
  "github.copilot.chat.terminalChatLocation": "terminal",
  "github.copilot.chat.followUps": "on",
  "github.copilot.chat.scopeSelection": true,
  "github.copilot.chat.localeOverride": "en",
  "github.copilot.chat.useProjectTemplates": true,
  "github.copilot.chat.generateTests.codeLens": true,
  "github.copilot.chat.generateDocs.codeLens": true,

  // Custom Instructions and Prompt Files (2026)
  // Use external instruction files instead of inline instructions
  // See: https://aka.ms/vscode-ghcp-custom-instructions
  "github.copilot.chat.codeGeneration.useInstructionFiles": true,

  // Edits Feature (2026)
  "github.copilot.chat.edits.enabled": true,
  "github.copilot.chat.edits.confirmationMode": "preview",

  // Agent Mode and Workspace Features (2026)
  "github.copilot.chat.search.semanticTextResults": true,
  "github.copilot.chat.search.engines": {
    "enabled": true,
    "bing": true
  },

  // Language Models (2026)
  "github.copilot.chat.model": "",

  // Chat Mode Configuration
  "github.copilot.chat.defaultMode": "default",

  // Use external instruction files instead of inline instructions
  // See: https://aka.ms/vscode-ghcp-custom-instructions
  "github.copilot.chat.codeGeneration.instructionFiles": [
    ".github/copilot-instructions.md"
  ],

  // Shellcheck integration settings
  "shellcheck.enable": true,
  "shellcheck.enableQuickFix": true,
  "shellcheck.run": "onType",
  "shellcheck.exclude": [],
  "shellcheck.customArgs": ["--external-sources", "--check-sourced"],
  "shellcheck.ignorePatterns": {
    "**/*.zsh": true,
    "**/*.bash_profile": true,
    "**/*.bashrc": true,
    "reference_projects/**": true
  },
  "shellcheck.useWorkspaceRootAsCwd": true,

  // Git commit validation settings
  "git.inputValidation": true,
  "git.inputValidationLength": 50,
  "git.inputValidationSubjectLength": 50,
  "git.showCommitInput": true,
  "git.verboseCommit": true,

  "files.associations": {
    "*.rs": "rust",
    "Cargo.toml": "toml",
    "Cargo.lock": "toml",
    "*.toml": "toml",
    "Dockerfile*": "dockerfile",
    "docker-compose*.yml": "dockercompose",
    "docker-compose*.yaml": "dockercompose",
    "*.sh": "shellscript",
    "*.bash": "shellscript",
    "commit-msg": "shellscript",
    "pre-commit": "shellscript",
    "post-commit": "shellscript",
    "pre-push": "shellscript",
    "scripts/*": "shellscript"
  },

  "files.exclude": {
    "**/.git": true,
    "**/.DS_Store": true,
    "**/node_modules": true,
    "**/*.exe": true,
    "**/target/debug": true,
    "**/target/release": true,
    "**/.vscode/settings.json": false
  },

  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/target/**": true,
    "**/tmp/**": true,
    "reference_projects/**": true
  },

  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "Cargo.toml": "Cargo.lock",
    "Dockerfile": "Dockerfile*, .dockerignore, docker-compose*, .docker*",
    "README.md": "README*, LICENSE*, CHANGELOG*, CONTRIBUTING*, SECURITY*",
    "*.rs": "${capture}_test.rs, ${capture}.md",
    "lib.rs": "main.rs",
    "mod.rs": "*.rs"
  },

  "search.exclude": {
    "**/node_modules": true,
    "**/target": true,
    "**/.git": true,
    "**/tmp": true,
    "**/*.rlib": true,
    "**/*.rmeta": true,
    "**/Cargo.lock": false,
    "reference_projects/**": true
  },

  "[markdown]": {
    "editor.formatOnSave": true,
    "editor.wordWrap": "on",
    "editor.rulers": [80, 120, 160],
    "files.trimTrailingWhitespace": false
  },

  // Markdown linting configuration
  "markdownlint.config": {
    "MD013": {
      "line_length": 180,
      "code_blocks": false,
      "tables": false
    },
    "MD029": false, // Ordered list item prefix - allow different numbering styles
    "MD010": false, // Hard tabs - allow tabs in code blocks (Makefiles)
    "MD032": false, // Blanks around lists - more flexible list formatting
    "MD036": {
      // No emphasis as heading - allow emphasis for styling
      "punctuation": ".,;:!?"
    }
  },

  // File-specific markdown lint ignores
  "markdownlint.ignore": [
    "docs/c4_diagramming_guide.md",
    "docs/battle_tested_libraries.md",
    "LICENSE",
    "reference_projects/**"
  ],

  "emmet.excludeLanguages": ["rust"],

  "security.workspace.trust.enabled": true,
  "security.workspace.trust.startupPrompt": "always",
  "security.workspace.trust.untrustedFiles": "open",

  "terminal.integrated.env.osx": {
    "RUST_BACKTRACE": "1",
    "CARGO_TERM_COLOR": "always",
    "RUSTFLAGS": "-D warnings"
    // Note: GitHub authentication is handled through:
    // 1. VS Code's built-in Git credential manager (preferred)
    // 2. GitHub CLI: gh auth login (for terminal operations)
    // 3. Git credential helper configured in ~/.gitconfig
    // Setting tokens as env vars in VS Code settings is not recommended for security
  },

  "terminal.integrated.profiles.osx": {
    "bash": {
      "path": "/opt/homebrew/bin/bash",
      "args": ["--rcfile", "/Users/nickcampbell/.bashrc_simple"],
      "icon": "terminal-bash"
      // Note: ~/.bashrc_simple includes automatic VS Code shell integration
      // and redirects to full ~/.bashrc when needed
    },
    "PowerShell": {
      "path": "/usr/local/bin/pwsh",
      "icon": "terminal-powershell",
      "color": "terminal.ansiBlue"
      // Note: PowerShell profile includes VS Code shell integration
    },
    "zsh": {
      "path": "zsh",
      "args": [
        "-c",
        "source /Users/nickcampbell/.bashrc_simple 2>/dev/null || true; exec zsh"
      ]
    }
  },

  "terminal.integrated.defaultProfile.osx": "bash",

